        "{number} {district}",
        "{city}, {region}",
        "{postal} {country}"
      ],
      "latinNote": {
        "en": "Written in Japanese, the address starts with the prefecture and ends with the recipient. In Latin letters the order is reversed, small to large.",
        "zh": "用日文书写时从都道府县写起、收件人放最后；用拉丁字母书写时顺序相反，从小到大。"
      },
