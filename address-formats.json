  "countries": [
    {
      "code": "US",
      "country": "United States",
      "postal": {
        "name": "ZIP Code",
        "format": "NNNNN or NNNNN-NNNN",
        "regex": "^\\d{5}(-\\d{4})?$",
        "examples": [
          "11550",
          "22162-1010"
        ],
        "note": {
          "en": "The 4 digits after the hyphen (ZIP+4) are optional.",
          "zh": "连字符后的 4 位（ZIP+4）可选。"
        }
      },
      "order": "small-to-large",
      "addressTemplate": [
        "{recipient}",
        "{number} {street} {unit}",
        "{city} {region} {postal}",
        "{country}"
      ],
      "latinTemplate": null,
      "latinNote": null,
      "phone": {
        "code": "+1",
        "mobileLength": [
          10
        ],
        "e164": "+12025550123",
        "local": "(202) 555-0123"
      },
      "regionLevel": {
        "name": {
          "en": "State",
          "zh": "州"
        },
        "written": true,
        "note": {
          "en": "Two-letter USPS code, e.g. NY.",
          "zh": "写两字母州代码，如 NY。"
        }
      },
      "idName": {
        "name": "Social Security number (SSN)",
