      "postal": {
        "name": "Postcode",
        "format": "AN NAA, ANN NAA, AAN NAA, AANN NAA, ANA NAA, AANA NAA",
        "regex": "^(GIR ?0AA|[A-PR-UWYZ](\\d{1,2}|[A-HK-Y]\\d{1,2}|\\d[A-HJKPSTUW]|[A-HK-Y]\\d[ABEHMNPRV-Y]) ?\\d[ABD-HJLNP-UW-Z]{2})$",
        "examples": [
          "EC1Y 8SY",
          "M2 5BQ"
        ],
        "note": {
          "en": "Six shapes plus GIR 0AA. The last part (inward code) never uses C, I, K, M, O or V. British Forces (BFPO) and overseas territory codes are not covered.",
          "zh": "共六种结构，外加特例 GIR 0AA。后半段不使用 C、I、K、M、O、V。不含英军（BFPO）和海外领地邮编。"
        }
